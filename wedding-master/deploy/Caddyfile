beluga.uz {
	encode zstd gzip

	# Tug'ilgan kun tabriklari (makeMeHappy, /opt/birthday) — prefiksni olib uzatadi,
	# Django havolalarga uni o'zi qaytaradi (URL_PREFIX=/birthday)
	redir /birthday /birthday/ permanent
	handle_path /birthday/* {
		reverse_proxy birthday:8000
	}

	handle {
		reverse_proxy app:5050
	}
}

www.beluga.uz {
	redir https://beluga.uz{uri} permanent
}

# Boshqa har qanday host (masalan server IP manzili) — DNS o'tkazilishidan
# oldin sinash uchun oddiy HTTP orqali
http:// {
	reverse_proxy app:5050
}
